<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<DisableDiagnosticTracing>true</DisableDiagnosticTracing>
		
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
		
		<!-- 发布时禁用 PDB 符号输出 -->
		<DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
		<DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="6.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<!-- Used for rendering -->
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
		<PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
		<!-- Used by format parsers -->
		<PackageReference Include="PeNet" Version="4.1.1" />
		<!-- Used by SdlExporter -->
		<PackageReference Include="SDL-Sharp" Version="2.2.5" />
		<PackageReference Include="SDL-Sharp-DLL" Version="2.1.4" />
		<!-- Used by FfmpegExporter -->
		<PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
		<!-- Used for real audio decoding (mp3/flac/ogg/wav 等) -->
		<PackageReference Include="CSCore" Version="1.2.1.2" />
		<PackageReference Include="CSCore.Ogg" Version="1.0.0.1" />
		<!-- Used for reading audio metadata (album/artist/genre 等) -->
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
		<!-- Used for GPU detection on Windows -->
		<PackageReference Include="System.Management" Version="10.0.0-rc.1.25451.107" />
		<!-- libyuv 色彩空间转换 -->
		<PackageReference Include="Lennox.LibYuvSharp" Version="1.0.4" />
		<!-- 对象池 -->
		<PackageReference Include="Microsoft.Extensions.ObjectPool" Version="9.0.0" />
	</ItemGroup>

</Project>
