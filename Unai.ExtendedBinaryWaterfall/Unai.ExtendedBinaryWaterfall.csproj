<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<DisableDiagnosticTracing>true</DisableDiagnosticTracing>
		
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="6.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<!-- Used for rendering -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
		<PackageReference Include="SixLabors.Fonts" Version="2.0.3" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.2" />
		<!-- Used by format parsers -->
		<PackageReference Include="PeNet" Version="4.1.1" />
		<!-- Used by SdlExporter -->
		<PackageReference Include="SDL-Sharp" Version="2.2.5" />
		<PackageReference Include="SDL-Sharp-DLL" Version="2.1.4" />
		<!-- Used by FfmpegExporter -->
		<PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
		<!-- Used for real audio decoding (mp3/flac/ogg/wav 等) -->
		<PackageReference Include="CSCore" Version="1.2.1.2" />
		<PackageReference Include="CSCore.Ogg" Version="1.0.0.1" />
		<!-- Used for reading audio metadata (album/artist/genre 等) -->
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
	</ItemGroup>

</Project>
